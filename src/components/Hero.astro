<section id="hero">
  <div class="container">
    <p class="mono intro">// software engineer · software security</p>
    <h1>Farzan Khalili</h1>
    <p class="tagline">
      I build systems that are reliable, scalable, and secure —
      and that hold up when someone tries to break them.
      Open to remote collaborations.
    </p>
    <div class="links">
      <a href="https://github.com/Farzan-Kh" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="https://linkedin.com/in/farzan-kh" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href="mailto:farzankhalili01@gmail.com">Email ↗</a>
    </div>
  </div>
</section>

<style>
  #hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    border-top: none;
  }

  .intro {
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #f5f5f5;
    margin-bottom: 1.5rem;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 500px;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .hl { color: var(--text); }

  .links {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .links a {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: color 0.15s, border-color 0.15s;
  }

  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
