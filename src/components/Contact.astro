<section id="contact">
  <div class="container">
    <p class="mono">// contact</p>
    <h2 class="section-title">Get in touch</h2>
    <p class="section-sub">
      Open to new roles, collaborations, or just a conversation.
      Reach out and I'll get back within 24 hours.
    </p>

    <div class="contact-block">
      <a href="mailto:farzankhalili01@gmail.com" class="email">
        farzankhalili01@gmail.com
      </a>
      <div class="contact-links">
        <a href="https://github.com/Farzan-Kh" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://linkedin.com/in/farzan-kh" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://t.me/FarzanKhalili" target="_blank" rel="noopener">Telegram ↗</a>
      </div>
    </div>

    <p class="footer">
      Farzan Khalili · {new Date().getFullYear()}
    </p>
  </div>
</section>

<style>
  #contact { padding-bottom: 5rem; }

  .contact-block {
    margin-top: 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .email {
    font-size: 1.15rem;
    font-weight: 600;
    color: #f5f5f5;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: color 0.15s, border-color 0.15s;
  }

  .email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact-links {
    display: flex;
    gap: 2rem;
  }

  .contact-links a {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .contact-links a:hover { color: var(--accent); }

  .footer {
    margin-top: 3rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    text-align: center;
  }
</style>
