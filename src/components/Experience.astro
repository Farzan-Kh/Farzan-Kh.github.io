---
const jobs = [
  {
    role: 'Software Engineer',
    company: 'Rayan Samaneh Arka',
    period: 'Aug 2025 — Present',
    location: 'Tabriz, Iran',
    bullets: [
      'Contributed to design and development of email infrastructure products, from system architecture and security planning through to end-to-end implementation.',
      'Developed and maintained backend components for email server and related infrastructure products.',
      'Established coding standards, Git workflows, and technical documentation practices across the engineering team.',
      'Reviewed and updated compliance documentation to support lab regulatory requirements.',
    ],
  },
  {
    role: 'Penetration Tester',
    company: 'Shiraz CERT',
    period: 'Jun 2024 — Aug 2024',
    location: 'Shiraz, Iran',
    bullets: [
      'Conducted penetration tests on web applications and network systems, identifying vulnerabilities and assessing security risks.',
      'Used Burp Suite and other industry-standard tools to perform vulnerability assessments.',
      'Delivered detailed reports with risk assessments and actionable remediation recommendations.',
    ],
  },
  {
    role: 'Software Developer',
    company: 'Novin Robat Sazan Emrooz',
    period: 'Jun 2023 — Aug 2023',
    location: 'Shiraz, Iran',
    bullets: [
      'Built a signal generation tool using a computer\'s sound card to emit configurable stereo signals with specified frequency and waveform.',
      'Developed a real-time GUI to monitor and visualize signals as they are emitted.',
    ],
  },
];

const education = [
  {
    degree: "Master's degree, Digital Forensics",
    school: 'Tarbiat Modares University',
    period: 'Oct 2025 — Present',
  },
  {
    degree: 'Bachelor of Science, Computer Science',
    school: 'Urmia University',
    period: '2020 — 2024',
  },
];
---

<section id="experience">
  <div class="container">
    <p class="mono">// experience</p>
    <h2 class="section-title">Where I've worked</h2>

    <div class="exp-list">
      {jobs.map(job => (
        <div class="exp-row">
          <div class="exp-meta">
            <span class="mono period">{job.period}</span>
            <span class="location">{job.location}</span>
          </div>
          <div class="exp-body">
            <div class="exp-header">
              <h3>{job.role}</h3>
              <span class="company">{job.company}</span>
            </div>
            <ul>
              {job.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <p class="mono edu-label">// education</p>
    <div class="edu-list">
      {education.map(e => (
        <div class="edu-row">
          <span class="mono period">{e.period}</span>
          <div>
            <p class="edu-degree">{e.degree}</p>
            <p class="edu-school">{e.school}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-list {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .exp-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-row:first-child { border-top: 1px solid var(--border); }

  .exp-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.1rem;
  }

  .period { color: var(--text-muted); }

  .location {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .exp-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .exp-header h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #f5f5f5;
  }

  .company {
    font-size: 0.875rem;
    color: var(--accent);
    font-family: var(--mono);
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  li {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-left: 1rem;
    position: relative;
    line-height: 1.65;
  }

  li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .edu-label {
    margin-top: 4rem;
    margin-bottom: 1.5rem;
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .edu-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .edu-degree {
    font-size: 0.9rem;
    font-weight: 600;
    color: #f5f5f5;
    margin-bottom: 0.2rem;
  }

  .edu-school {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .exp-row, .edu-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .exp-meta { flex-direction: row; gap: 1rem; }
  }
</style>
